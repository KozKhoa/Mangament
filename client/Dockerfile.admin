# ==========================================
# Dockerfile for Frontend Admin App
# ==========================================
FROM node:22-alpine AS base
RUN apk add --no-cache libc6-compat
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
RUN npm install -g turbo

# 1. Prune source code to only admin app and dependencies
FROM base AS builder
WORKDIR /app
COPY . .
RUN turbo prune admin --docker

# 2. Install dependencies (cached when package.json / pnpm-lock don't change)
FROM base AS installer
WORKDIR /app
COPY --from=builder /app/out/json/ .
RUN pnpm install

# 3. Build admin Next.js standalone application
COPY --from=builder /app/out/full/ .
COPY --from=builder /app/packages/config-typescript ./packages/config-typescript
COPY --from=builder /app/packages/ui/public ./packages/ui/public
COPY --from=builder /app/apps/admin/public ./apps/admin/public

ARG NEXT_PUBLIC_API_URL=https://api.mangament.io.vn
ARG NEXT_PUBLIC_ADMIN_URL=https://admin.mangament.io.vn
ARG NEXT_PUBLIC_WEB_URL=https://mangament.io.vn
ARG NEXT_PUBLIC_AUTH_URL=https://admin.mangament.io.vn
ARG NEXT_PUBLIC_CDN_URL=https://api.mangament.io.vn
ARG NEXT_PUBLIC_LOCAL_CDN_URL=https://api.mangament.io.vn
ARG NEXT_PUBLIC_R2_CDN_URL=https://pub-626aeddeabe146fb92f0e8ca1377235a.r2.dev
ARG NEXT_PUBLIC_API_KEY=mangamentj4KvFLZVM2950whgoRDTYiy9EwYm7KlVi6Oyph42bMXTM3AnVRXBhiSF57ww91sx
ARG NEXT_PUBLIC_COOKIE_DOMAIN=.mangament.io.vn
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID
ARG NEXT_PUBLIC_GOOGLE_CLIENT_SECRET
ARG AUTH_SECRET
ARG NEXTAUTH_SECRET

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_ADMIN_URL=$NEXT_PUBLIC_ADMIN_URL
ENV NEXT_PUBLIC_WEB_URL=$NEXT_PUBLIC_WEB_URL
ENV NEXT_PUBLIC_AUTH_URL=$NEXT_PUBLIC_AUTH_URL
ENV NEXT_PUBLIC_CDN_URL=$NEXT_PUBLIC_CDN_URL
ENV NEXT_PUBLIC_LOCAL_CDN_URL=$NEXT_PUBLIC_LOCAL_CDN_URL
ENV NEXT_PUBLIC_R2_CDN_URL=$NEXT_PUBLIC_R2_CDN_URL
ENV NEXT_PUBLIC_API_KEY=$NEXT_PUBLIC_API_KEY
ENV NEXT_PUBLIC_COOKIE_DOMAIN=$NEXT_PUBLIC_COOKIE_DOMAIN
ENV NEXT_PUBLIC_GOOGLE_CLIENT_ID=$NEXT_PUBLIC_GOOGLE_CLIENT_ID
ENV NEXT_PUBLIC_GOOGLE_CLIENT_SECRET=$NEXT_PUBLIC_GOOGLE_CLIENT_SECRET
ENV AUTH_SECRET=$AUTH_SECRET
ENV NEXTAUTH_SECRET=$NEXTAUTH_SECRET

RUN turbo build --filter=admin

# 4. Production Runner image
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=installer --chown=nextjs:nodejs /app/apps/admin/.next/standalone ./
COPY --from=installer --chown=nextjs:nodejs /app/apps/admin/.next/static ./apps/admin/.next/static
COPY --from=installer --chown=nextjs:nodejs /app/apps/admin/public ./apps/admin/public

USER nextjs

EXPOSE 3001
ENV PORT=3001
ENV HOSTNAME="0.0.0.0"

CMD ["node", "apps/admin/server.js"]
