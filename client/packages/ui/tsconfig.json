{
  "extends": "@mangament/config-typescript/nextjs.json",
  "compilerOptions": {
    "outDir": "./dist",
    "paths": {
      "@mangament/contexts": ["../contexts/src"],
      "@mangament/contexts/*": ["../contexts/src/*"],
      "@mangament/utils": ["../utils/src"],
      "@mangament/utils/*": ["../utils/src/*"],
      "@/components/*": ["./src/components/*"],
      "@/contexts/*": ["../contexts/src/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/constants/*": ["./src/constants/*"],
      "@/utils/*": ["./src/utils/*"],
      "@/hoc/*": ["./src/hoc/*"],
      "@/lib/*": ["../services/src/lib/*"],
      "@/services/*": ["../services/src/*"],
      "@/types/*": ["../types/src/*"],
      "@/public/*": ["./public/*"]
    }
  },
  "include": ["src/**/*"]
}
