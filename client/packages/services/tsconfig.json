{
  "extends": "@mangament/config-typescript/tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "types": ["node"],
    "paths": {
      "@/lib/*": ["./src/lib/*"],
      "@/types/*": ["../types/src/*"],
      "@/utils/*": ["./src/lib/*", "../ui/src/utils/*"],
      "@/services/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"]
}
