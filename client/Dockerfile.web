# ==========================================
# Dockerfile for Frontend Web App (Readers)
# ==========================================
FROM node:22-alpine AS base
RUN apk add --no-cache libc6-compat
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
RUN npm install -g turbo

# 1. Prune source code to only web app and dependencies
FROM base AS builder
WORKDIR /app
COPY . .
RUN turbo prune web --docker

# 2. Install dependencies (cached when package.json / pnpm-lock don't change)
FROM base AS installer
WORKDIR /app
COPY --from=builder /app/out/json/ .
RUN pnpm install

# 3. Build web Next.js standalone application
COPY --from=builder /app/out/full/ .
COPY --from=builder /app/packages/config-typescript ./packages/config-typescript
COPY --from=builder /app/packages/assets ./packages/assets
COPY --from=builder /app/scripts ./scripts
RUN node scripts/copy-assets.mjs

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_WEB_URL
ARG NEXT_PUBLIC_ADMIN_URL
ARG NEXT_PUBLIC_AUTH_URL
ARG NEXT_PUBLIC_CDN_URL
ARG NEXT_PUBLIC_LOCAL_CDN_URL
ARG NEXT_PUBLIC_R2_CDN_URL
ARG NEXT_PUBLIC_API_KEY
ARG NEXT_PUBLIC_COOKIE_DOMAIN
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID
ARG NEXT_PUBLIC_GOOGLE_CLIENT_SECRET
ARG AUTH_SECRET
ARG NEXTAUTH_SECRET

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WEB_URL=$NEXT_PUBLIC_WEB_URL
ENV NEXT_PUBLIC_ADMIN_URL=$NEXT_PUBLIC_ADMIN_URL
ENV NEXT_PUBLIC_AUTH_URL=$NEXT_PUBLIC_AUTH_URL
ENV NEXT_PUBLIC_CDN_URL=$NEXT_PUBLIC_CDN_URL
ENV NEXT_PUBLIC_LOCAL_CDN_URL=$NEXT_PUBLIC_LOCAL_CDN_URL
ENV NEXT_PUBLIC_R2_CDN_URL=$NEXT_PUBLIC_R2_CDN_URL
ENV NEXT_PUBLIC_API_KEY=$NEXT_PUBLIC_API_KEY
ENV NEXT_PUBLIC_COOKIE_DOMAIN=$NEXT_PUBLIC_COOKIE_DOMAIN
ENV NEXT_PUBLIC_GOOGLE_CLIENT_ID=$NEXT_PUBLIC_GOOGLE_CLIENT_ID
ENV NEXT_PUBLIC_GOOGLE_CLIENT_SECRET=$NEXT_PUBLIC_GOOGLE_CLIENT_SECRET
ENV AUTH_SECRET=$AUTH_SECRET
ENV NEXTAUTH_SECRET=$NEXTAUTH_SECRET

RUN turbo build --filter=web

# 4. Production Runner image
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=installer --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=installer --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=installer --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public

USER nextjs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "apps/web/server.js"]
