{
  "openapi": "3.0.0",
  "info": {
    "title": "Mangament API",
    "version": "1.0.0",
    "description": "OpenAPI specification for the Mangament server (auth, users, stories, story-nodes, authors, genres, comments, admin, uploads, cloudinary)."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  ,
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "role": { "type": "string" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "properties": { "email": { "type": "string" }, "password": { "type": "string" } },
        "required": ["email","password"]
      },
      "TokenResponse": {
        "type": "object",
        "properties": { "accessToken": { "type": "string" }, "refreshToken": { "type": "string" } }
      },
      "Story": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "authorId": { "type": "string" },
          "coverArtUrl": { "type": "string" },
          "views": { "type": "integer" }
        }
      },
      "StoryNode": {
        "type": "object",
        "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "content": { "type": "string" } }
      },
      "Author": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" } } },
      "Genre": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" } } },
      "Comment": { "type": "object", "properties": { "id": { "type": "string" }, "content": { "type": "string" }, "authorId": { "type": "string" } } },
      "Rating": { "type": "object", "properties": { "id": { "type": "string" }, "score": { "type": "integer" }, "userId": { "type": "string" } } }
    }
  },
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Register a new user",
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } },
        "responses": { "200": { "description": "User created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } } }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login",
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } } },
        "responses": { "200": { "description": "Tokens", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TokenResponse" } } } } }
      }
    },
    "/auth/logout": { "post": { "summary": "Logout", "security": [{"bearerAuth":[]}], "responses": { "200": { "description": "Logged out" } } } },
    "/auth/refresh": { "post": { "summary": "Refresh token", "responses": { "200": { "description": "New tokens" } } } },
    "/auth/me": { "get": { "summary": "Get current user", "security": [{"bearerAuth":[]}], "responses": { "200": { "description": "User", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } } } } ,

    "/users/me": { "get": { "summary": "Get current user profile", "security": [{"bearerAuth":[]}], "responses": { "200": { "description": "User" } } },
    "/users/{id}": {
      "get": { "summary": "Get user by id", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "security": [{"bearerAuth":[]}], "responses": { "200": { "description": "User" } } },
      "put": { "summary": "Update user by id", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "security": [{"bearerAuth":[]}], "responses": { "200": { "description": "Updated" } } },
      "delete": { "summary": "Delete user by id", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "security": [{"bearerAuth":[]}], "responses": { "200": { "description": "Deleted" } } }
    },
    "/users": { "get": { "summary": "List users", "security": [{"bearerAuth":[]}], "responses": { "200": { "description": "Users list" } } } },
    "/users/me/avatar": { "patch": { "summary": "Upload user avatar", "security": [{"bearerAuth":[]}], "requestBody": { "content": { "multipart/form-data": { "schema": { "type": "object", "properties": { "image": { "type": "string", "format": "binary" } } } } } }, "responses": { "200": { "description": "Avatar updated" } } } },

    "/users/me/favourites": { "post": { "summary": "Add favourite (current user)", "security": [{"bearerAuth":[]}], "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "storyId": { "type": "string" } }, "required": ["storyId"] } } } }, "responses": { "200": { "description": "Added" } } }, "get": { "summary": "Get favourites (current user)", "security": [{"bearerAuth":[]}], "responses": { "200": { "description": "List" } } } },

    "/users/me/histories": { "post": { "summary": "Add reading history", "security": [{"bearerAuth":[]}], "responses": { "200": { "description": "Added" } } }, "get": { "summary": "Get reading histories", "security": [{"bearerAuth":[]}], "responses": { "200": { "description": "List" } } } },
    "/users/me/histories/{historyId}": { "delete": { "summary": "Delete reading history", "security": [{"bearerAuth":[]}], "parameters": [{ "name": "historyId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Deleted" } } } },

    "/stories/random": { "get": { "summary": "Get random story", "responses": { "200": { "description": "Story" } } } },
    "/stories/{id}/review": { "get": { "summary": "Get story review", "parameters": [{ "name": "id","in":"path","required":true,"schema":{"type":"string"}}], "responses": { "200": { "description": "Reviews" } } } },
    "/stories/{id}": {
      "get": { "summary": "Get story by id","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}], "responses": { "200": { "description": "Story" } } },
      "patch": { "summary": "Increase story view", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "View incremented" } } }
    },
    "/stories/title/{title}": { "get": { "summary": "Get story by title","parameters":[{"name":"title","in":"path","required":true,"schema":{"type":"string"}}], "responses": { "200": { "description": "Stories" } } } },
    "/stories": {
      "get": { "summary": "List stories", "responses": { "200": { "description": "List" } } },
      "post": { "summary": "Create story (admin)", "security": [{"bearerAuth":[]}], "requestBody": { "content": { "multipart/form-data": { "schema": { "type": "object", "properties": { "coverArt": { "type": "string", "format": "binary" }, "title": { "type": "string" }, "authorId": { "type": "string" } }, "required": ["title"] } } } }, "responses": { "200": { "description": "Created" } } }
    },

    "/stories/{id}/ratings": { "post": { "summary": "Post rating (auth)", "security": [{"bearerAuth":[]}], "parameters": [{ "name": "id","in":"path","required":true,"schema":{"type":"string"}}], "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Rating" } } } }, "responses": { "200": { "description": "Created" } } } },
    "/stories/{id}/ratings/count": { "get": { "summary": "Get ratings count", "parameters": [{ "name": "id","in":"path","required":true,"schema":{"type":"string"}}], "responses": { "200": { "description": "Count" } } } },
    "/stories/{id}/ratings": { "get": { "summary": "Get ratings list", "parameters": [{ "name": "id","in":"path","required":true,"schema":{"type":"string"}}], "responses": { "200": { "description": "List" } } } },
    "/stories/ratings/{id}": { "put": { "summary": "Update rating (auth)", "security": [{"bearerAuth":[]}], "parameters": [{ "name": "id","in":"path","required":true,"schema":{"type":"string"}}], "responses": { "200": { "description": "Updated" } } }, "delete": { "summary": "Delete rating (auth)", "security": [{"bearerAuth":[]}], "parameters": [{ "name": "id","in":"path","required":true,"schema":{"type":"string"}}], "responses": { "200": { "description": "Deleted" } } } },

    "/story-nodes/{id}": { "get": { "summary": "Get story node", "parameters": [{ "name": "id","in":"path","required":true,"schema":{"type":"string"}}], "responses": { "200": { "description": "Node" } } }, "patch": { "summary": "Increase node view", "parameters": [{ "name": "id","in":"path","required":true,"schema":{"type":"string"}}], "responses": { "200": { "description": "View increased" } } }, "delete": { "summary": "Delete node (admin)", "security": [{"bearerAuth":[]}], "parameters": [{ "name": "id","in":"path","required":true,"schema":{"type":"string"}}], "responses": { "200": { "description": "Deleted" } } } },
    "/story-nodes": { "post": { "summary": "Create node (admin)", "security": [{"bearerAuth":[]}], "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StoryNode" } } } }, "responses": { "200": { "description": "Created" } } } },
    "/story-nodes/{id}/content": { "patch": { "summary": "Update node content with images (admin)", "security": [{"bearerAuth":[]}], "parameters": [{ "name": "id","in":"path","required":true,"schema":{"type":"string"}}], "requestBody": { "content": { "multipart/form-data": { "schema": { "type": "object", "properties": { "images": { "type": "array", "items": { "type": "string", "format": "binary" } } } } } } }, "responses": { "200": { "description": "Updated" } } } },

    "/authors": { "get": { "summary": "List authors", "responses": { "200": { "description": "List" } } }, "post": { "summary": "Create author (admin)", "security": [{"bearerAuth":[]}], "requestBody": { "content": { "multipart/form-data": { "schema": { "type": "object", "properties": { "image": { "type": "string", "format": "binary" }, "name": { "type": "string" } }, "required": ["name"] } } } }, "responses": { "200": { "description": "Created" } } } },

    "/genres": { "get": { "summary": "List genres", "responses": { "200": { "description": "List" } } } },

    "/comments/story/{storyId}": { "get": { "summary": "Get comments for story", "parameters": [{ "name": "storyId","in":"path","required":true,"schema":{"type":"string"}}], "responses": { "200": { "description": "List" } } }, "post": { "summary": "Post comment on story", "security": [{"bearerAuth":[]}], "requestBody": { "content": { "application/json": { "schema": { "type": "object","properties": { "content": { "type": "string" }, "parentCommentId": { "type": "string" } }, "required": ["content"] } } } }, "responses": { "200": { "description": "Created" } } } },
    "/comments/story/{storyId}/story-node/{storyNodeId}": { "get": { "summary": "Get comments for story node", "parameters": [{ "name": "storyId","in":"path","required":true,"schema":{"type":"string"}},{"name":"storyNodeId","in":"path","required":true,"schema":{"type":"string"}}], "responses": { "200": { "description": "List" } } }, "post": { "summary": "Post comment on story node", "security": [{"bearerAuth":[]}], "responses": { "200": { "description": "Created" } } } },
    "/comments/{id}": { "put": { "summary": "Update comment (auth)", "security": [{"bearerAuth":[]}], "parameters": [{ "name": "id","in":"path","required":true,"schema":{"type":"string"}}], "responses": { "200": { "description": "Updated" } } }, "delete": { "summary": "Delete comment (auth)", "security": [{"bearerAuth":[]}], "parameters": [{ "name": "id","in":"path","required":true,"schema":{"type":"string"}}], "responses": { "200": { "description": "Deleted" } } } },

    "/cloudinary/signature/story/{storyId}/cover-art": { "get": { "summary": "Create upload signature (admin)", "security": [{"bearerAuth":[]}], "parameters": [{ "name": "storyId","in":"path","required":true,"schema":{"type":"string"}}], "responses": { "200": { "description": "Signature" } } } },
    "/cloudinary/signature/storyType/{storyType}/storyTitle/{storyTitle}/cover-art": { "get": { "summary": "Create signature by type+title (admin)", "security": [{"bearerAuth":[]}], "responses": { "200": { "description": "Signature" } } } },
    "/cloudinary/signature/story-node/{storyNodeId}/content": { "get": { "summary": "Create signature for story-node content (admin)", "security": [{"bearerAuth":[]}], "parameters": [{ "name": "storyNodeId","in":"path","required":true,"schema":{"type":"string"}}], "responses": { "200": { "description": "Signature" } } } },

    "/uploads/user/me/avatar": { "post": { "summary": "Upload avatar (auth)", "security": [{"bearerAuth":[]}], "requestBody": { "content": { "multipart/form-data": { "schema": { "type": "object", "properties": { "image": { "type": "string", "format": "binary" } } } } } }, "responses": { "200": { "description": "Uploaded" } } } },
    "/uploads/user/{userId}/avatar": { "post": { "summary": "Upload avatar for user (admin)", "security": [{"bearerAuth":[]}], "parameters": [{ "name": "userId","in":"path","required":true,"schema":{"type":"string"}}], "requestBody": { "content": { "multipart/form-data": { "schema": { "type": "object", "properties": { "image": { "type": "string", "format": "binary" } } } } } }, "responses": { "200": { "description": "Uploaded" } } } },
    "/uploads/story/{storyId}/cover-art": { "post": { "summary": "Upload story cover (admin)", "security": [{"bearerAuth":[]}], "requestBody": { "content": { "multipart/form-data": { "schema": { "type": "object", "properties": { "image": { "type": "string", "format": "binary" } } } } } }, "responses": { "200": { "description": "Uploaded" } } } },
    "/uploads/story/{storyId}/story-node/{storyNodeId}/contents": { "post": { "summary": "Upload multiple images for story node (admin)", "security": [{"bearerAuth":[]}], "requestBody": { "content": { "multipart/form-data": { "schema": { "type": "object", "properties": { "images": { "type": "array", "items": { "type": "string", "format": "binary" } } } } } } }, "responses": { "200": { "description": "Uploaded" } } } },
    "/uploads/story/{storyId}/story-node/{storyNodeId}/content": { "post": { "summary": "Upload single image for story node (admin)", "security": [{"bearerAuth":[]}], "requestBody": { "content": { "multipart/form-data": { "schema": { "type": "object", "properties": { "image": { "type": "string", "format": "binary" } } } } } }, "responses": { "200": { "description": "Uploaded" } } } },

    "/admin/users": { "get": { "summary": "Admin: get all users", "security": [{"bearerAuth":[]}], "responses": { "200": { "description": "List" } } } },
    "/admin/users/{id}": { "get": { "summary": "Admin: get user", "security": [{"bearerAuth":[]}], "parameters": [{ "name": "id","in":"path","required":true,"schema":{"type":"string"}}], "responses": { "200": { "description": "User" } } }, "put": { "summary": "Admin: update user", "security": [{"bearerAuth":[]}], "responses": { "200": { "description": "Updated" } } }, "delete": { "summary": "Admin: delete user", "security": [{"bearerAuth":[]}], "responses": { "200": { "description": "Deleted" } } }, "patch": { "summary": "Admin: ban user", "security": [{"bearerAuth":[]}], "responses": { "200": { "description": "Banned" } } } },

    "/admin/dashboard/overview": { "get": { "summary": "Admin dashboard overview", "security": [{"bearerAuth":[]}], "responses": { "200": { "description": "Overview" } } } },
    "/admin/dashboard/stats/views": { "get": { "summary": "Admin: views stats", "security": [{"bearerAuth":[]}], "responses": { "200": { "description": "Stats" } } } },
    "/admin/dashboard/stats/new-users": { "get": { "summary": "Admin: new users stats", "security": [{"bearerAuth":[]}], "responses": { "200": { "description": "Stats" } } } },

    "/admin/stories": { "get": { "summary": "Admin: list stories","security":[{"bearerAuth":[]}], "responses": { "200": { "description": "List" } } }, "post": { "summary": "Admin: create story","security":[{"bearerAuth":[]}], "requestBody": { "content": { "multipart/form-data": { "schema": { "type": "object", "properties": { "coverArt": { "type": "string", "format": "binary" }, "title": { "type": "string" } } } } } }, "responses": { "200": { "description": "Created" } } } },
    "/admin/stories/{id}": { "get": { "summary": "Admin: get story", "security": [{"bearerAuth":[]}], "parameters": [{ "name": "id","in":"path","required":true,"schema":{"type":"string"}}], "responses": { "200": { "description": "Story" } } }, "put": { "summary": "Admin: update story (coverArt)", "security": [{"bearerAuth":[]}], "requestBody": { "content": { "multipart/form-data": { "schema": { "type": "object", "properties": { "coverArt": { "type": "string", "format": "binary" }, "title": { "type": "string" } } } } } }, "patch": { "summary": "Admin: toggle active", "security": [{"bearerAuth":[]}], "responses": { "200": { "description": "Toggled" } } }, "delete": { "summary": "Admin: delete story", "security": [{"bearerAuth":[]}], "responses": { "200": { "description": "Deleted" } } } },

    "/admin/images/trash": { "get": { "summary": "Admin: get trashed images", "security": [{"bearerAuth":[]}], "responses": { "200": { "description": "List" } } } }
  }
}
