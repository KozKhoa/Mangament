// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum StoryNodeContentType {
  image
  text
  header
  title
}

enum Role {
  user
  admin
}

enum StoryStatus {
  ongoing
  finished
  postpone
  upcoming
}

enum StoryType {
  manga
  light_novel
  web_novel
  anime
}

enum StoryNodeType {
  chapter
  arc
  volume
}

enum Gender {
  male
  female
  other
}

enum Genre {
  action
  adventure
  comedy
  crime
  cyberpunk
  dark_fantasy
  detective
  drama
  dystopian_fiction
  ecchi
  fairy_tale
  fantasy
  fiction
  gekiga
  gothic_fiction
  harem
  high_fantasy
  historical
  historical_fiction
  horror
  isekai
  josei
  kodomo
  literary_fiction
  low_fantasy
  magical_realism
  martial_arts
  mecha
  mystery
  parody
  post_apocalyptic
  psychology
  romance
  science_fiction
  seinen
  shojo
  shonen
  shoujo_ai
  shounen_ai
  slice_of_life
  space_opera
  sport
  steampunk
  supernatural
  survival
  thriller
  tragedy
  yaoi
  yuri
}

model User {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  email      String    @unique
  password   String
  gender     Gender?   @default(other)
  birthday   DateTime?
  join_date  DateTime  @default(now())
  role       Role      @default(user)
  nation_id  String?   @db.Uuid
  avatar_id  String?   @db.Uuid
  is_deleted Boolean   @default(false)
  is_banned  Boolean   @default(false)

  avatar Image?  @relation(fields: [avatar_id], references: [id], onDelete: SetNull)
  nation Nation? @relation(fields: [nation_id], references: [id], onDelete: SetNull)

  reading_history   ReadingHistory[]
  favourite_story   FavouriteStory[]
  story_rating      Rating[]
  comments          Comment[]
  refresh_token     RefreshToken[]
  posted_story      Story[] // List of story that admin posted
  poster_story_node StoryNode[]
}

model Story {
  id                 String      @id @default(uuid()) @db.Uuid
  title              String     @unique
  view               Int         @default(0)
  star               Float       @default(0)
  rating_count       Int         @default(0) // Number of rating
  type               StoryType
  status             StoryStatus @default(ongoing)
  next_chapter_in    DateTime?
  number_of_children Int         @default(0)
  cover_art_id       String?     @db.Uuid
  nation_id          String?     @db.Uuid()
  is_deleted         Boolean     @default(false)
  is_actived         Boolean     @default(true)
  poster_id          String?     @db.Uuid // Admin who post this story on
  created_at         DateTime    @default(now())
  updated_at         DateTime    @default(now())
  summary            String?

  cover_art Image?  @relation(fields: [cover_art_id], references: [id], onDelete: SetNull)
  poster    User?   @relation(fields: [poster_id], references: [id], onDelete: SetNull) // admin who post this story on
  nation    Nation? @relation(fields: [nation_id], references: [id], onDelete: SetNull)

  children        StoryNode[]
  reading_history ReadingHistory[]
  rating          Rating[]
  favourite       FavouriteStory[]
  comment         Comment[]
  authors         Story_Author[]
  genres          Story_Genre[]
}

model StoryNode {
  id                 String                   @id @default(uuid()) @db.Uuid
  story_id           String?                  @db.Uuid
  parent_id          String?                  @db.Uuid
  title              String?
  type               StoryNodeType
  order_index        Float?                   @db.Real
  view               Int                      @default(0)
  number_of_children Int                      @default(0)
  updated_at         DateTime                 @default(now())
  created_at         DateTime                 @default(now())
  plain_text         String?
  search_vector      Unsupported("tsvector")? // Prisma chưa hỗ trợ tsvector
  is_deleted         Boolean                  @default(false)
  poster_id          String?                  @db.Uuid // Which admin post it

  story           Story?             @relation(fields: [story_id], references: [id], onDelete: Cascade)
  parent          StoryNode?         @relation("StoryNodeToStoryNode", fields: [parent_id], references: [id], onDelete: Cascade)
  children        StoryNode[]        @relation("StoryNodeToStoryNode")
  poster          User?              @relation(fields: [poster_id], references: [id], onDelete: SetNull)
  content         StoryNodeContent[]
  reading_history ReadingHistory[]
  comment         Comment[]

  // @@unique([story_id, parent_id, type, order_index]) 
}

model StoryNodeContent {
  id            String               @id @default(uuid()) @db.Uuid
  story_node_id String               @db.Uuid()
  type          StoryNodeContentType @default(text)
  order_index   Int
  content       String?
  image_id      String?              @db.Uuid()
  
  is_deleted Boolean @default(false)
  created_at         DateTime    @default(now())

  story_node StoryNode @relation(fields: [story_node_id], references: [id], onDelete: Cascade)
  image      Image?    @relation(fields: [image_id], references: [id], onDelete: Cascade)

  // @@unique([story_node_id, order_index])
}

model Image {
  id         String  @id @default(uuid()) @db.Uuid
  url        String?  @unique
  key        String? @unique // This key is use for clouldflare r2
  public_id  String? @unique //  This contain public id of cloudinary
  width      Int?
  height     Int?

  is_deleted Boolean @default(false)
  created_at         DateTime    @default(now())

  user               User[]
  story              Story[]
  nation             Nation[]
  story_node_content StoryNodeContent[]
}

model Author {
  id        String  @id @default(uuid()) @db.Uuid
  name      String
  nation_id String? @db.Uuid()

  nation Nation?        @relation(fields: [nation_id], references: [id], onDelete: SetNull)
  story  Story_Author[]
}

model Story_Author {
  story_id  String @db.Uuid
  author_id String @db.Uuid

  story  Story  @relation(fields: [story_id], references: [id], onDelete: Cascade)
  author Author @relation(fields: [author_id], references: [id], onDelete: Cascade)

  @@id([story_id, author_id])
}

model ReadingHistory {
  id            String   @id @default(uuid()) @db.Uuid
  user_id       String   @db.Uuid
  story_id      String   @db.Uuid
  story_node_id String   @db.Uuid
  last_position Json? // e.g., { "page": 5, "offset": 120 }
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now())
  is_deleted    Boolean  @default(false)

  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  story      Story     @relation(fields: [story_id], references: [id], onDelete: Cascade)
  story_node StoryNode @relation(fields: [story_node_id], references: [id], onDelete: Cascade)
}

model FavouriteStory {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  story_id   String   @db.Uuid
  created_at DateTime @default(now())

  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  story Story @relation(fields: [story_id], references: [id], onDelete: Cascade)

  @@unique([user_id, story_id])
}

model Nation {
  id            String  @id @default(uuid()) @db.Uuid
  flag_image_id String? @db.Uuid
  flag_icon     String?
  name          String

  flag_image Image? @relation(fields: [flag_image_id], references: [id], onDelete: SetNull)

  user   User[]
  story  Story[]
  author Author[]

  @@unique([name])
}

model Story_Genre {
  story_id String @db.Uuid
  genre    Genre

  story Story @relation(fields: [story_id], references: [id], onDelete: Cascade)

  @@id([story_id, genre])
}

model Rating {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  story_id   String   @db.Uuid
  star       Int      @default(0) // 0-5\
  title      String
  content    String
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  is_deleted Boolean  @default(false)

  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  story Story @relation(fields: [story_id], references: [id], onDelete: Cascade)

  @@unique([user_id, story_id])
}

model Comment {
  id            String   @id @default(uuid()) @db.Uuid
  parent_id     String?  @db.Uuid // reply to another comment
  story_id      String   @db.Uuid
  story_node_id String?  @db.Uuid
  user_id       String   @db.Uuid
  title         String
  content       String
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now())
  is_deleted    Boolean  @default(false)

  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  story      Story      @relation(fields: [story_id], references: [id], onDelete: Cascade)
  story_node StoryNode? @relation(fields: [story_node_id], references: [id], onDelete: Cascade)
  parent     Comment?   @relation("CommentToComment", fields: [parent_id], references: [id], onDelete: Cascade)
  children   Comment[]  @relation("CommentToComment")
}

model RefreshToken {
  user_id String @db.Uuid
  token   String @unique

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, token])
}
