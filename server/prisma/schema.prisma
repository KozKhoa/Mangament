// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

enum StoryStatus {
  ongoing
  finished
  postpone
  upcoming
}

enum StoryType {
  manga
  light_novel
  web_novel
  anime
}

enum StoryNodeType {
  chapter
  arc
  volume
}

enum Gender {
  male
  female
  other
}

enum Genre {
  action
  adventure
  comedy
  crime
  cyberpunk
  dark_fantasy
  detective
  drama
  dystopian_fiction
  ecchi
  fairy_tale
  fantasy
  fiction
  gekiga
  gothic_fiction
  harem
  high_fantasy
  historical
  historical_fiction
  horror
  isekai
  josei
  kodomo
  literary_fiction
  low_fantasy
  magical_realism
  martial_arts
  mecha
  mystery
  parody
  post_apocalyptic
  psychology
  romance
  science_fiction
  seinen
  shojo
  shonen
  shoujo_ai
  shounen_ai
  slice_of_life
  space_opera
  sport
  steampunk
  supernatural
  survival
  thriller
  tragedy
  yaoi
  yuri
}

model User {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  email      String    @unique
  password   String
  gender     Gender?   @default(other)
  birthday   DateTime?
  join_date  DateTime  @default(now())
  role       Role      @default(user)
  avatar_id  String?   @db.Uuid
  is_deleted Boolean   @default(false)

  avatar Image? @relation(fields: [avatar_id], references: [id], onDelete: SetNull)

  reading_history ReadingHistory[]
  favourite_story FavouriteStory[]
  story_rating    Rating[]
  comment         Comment[]
  refresh_token   RefreshToken[]
}

model Story {
  id                 String      @id @default(uuid()) @db.Uuid
  title              String      @unique
  nation             String?
  view               Int         @default(0)
  star               Float       @default(0)
  type               StoryType
  status             StoryStatus @default(ongoing)
  next_chapter_in    DateTime?
  number_of_children Int         @default(0)
  cover_art_id       String?     @db.Uuid
  is_deleted         Boolean     @default(false)
  update_at          DateTime    @default(now())

  cover_art Image? @relation(fields: [cover_art_id], references: [id], onDelete: SetNull)

  story_node           StoryNode[]
  user_reading_history ReadingHistory[]
  genre                Story_Genre[]
  rating               Rating[]
  user_favourite       FavouriteStory[]
  comment              Comment[]
  author               Story_Author[]
}

model StoryNode {
  id                 String                   @id @default(uuid()) @db.Uuid
  story_id           String?                  @db.Uuid
  parent_id          String?                  @db.Uuid
  title              String
  type               StoryNodeType
  order_index        Int?
  view               Int                      @default(0)
  number_of_children Int                      @default(0)
  update_at          DateTime                 @default(now())
  content            Json?
  plain_text         String?
  search_vector      Unsupported("tsvector")? // Prisma chưa hỗ trợ tsvector
  is_deleted         Boolean                  @default(false)

  story    Story?      @relation(fields: [story_id], references: [id], onDelete: Cascade)
  parent   StoryNode?  @relation("StoryNodeToStoryNode", fields: [parent_id], references: [id], onDelete: Cascade)
  children StoryNode[] @relation("StoryNodeToStoryNode")

  reading_history ReadingHistory[]
  comment         Comment[]

  @@unique([story_id, parent_id, order_index])
}

model Image {
  id         String  @id @default(uuid()) @db.Uuid
  url        String  @unique
  width      Int?
  height     Int?
  is_deleted Boolean @default(false)

  user  User[]
  story Story[]
}

model Author {
  id   String @id @default(uuid()) @db.Uuid
  name String

  story Story_Author[]
}

model Story_Author {
  story_id  String @db.Uuid
  author_id String @db.Uuid

  story  Story  @relation(fields: [story_id], references: [id], onDelete: Cascade)
  author Author @relation(fields: [author_id], references: [id], onDelete: Cascade)

  @@id([story_id, author_id])
}

model ReadingHistory {
  id            String   @id @default(uuid()) @db.Uuid
  user_id       String   @db.Uuid
  story_id      String   @db.Uuid
  story_node_id String   @db.Uuid
  last_position Json? // e.g., { "page": 5, "offset": 120 }
  create_at     DateTime @default(now())
  is_deleted    Boolean  @default(false)

  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  story      Story     @relation(fields: [story_id], references: [id], onDelete: Cascade)
  story_node StoryNode @relation(fields: [story_node_id], references: [id], onDelete: Cascade)
}

model FavouriteStory {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  story_id   String   @db.Uuid
  create_at  DateTime @default(now())
  is_deleted Boolean  @default(false)

  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  story Story @relation(fields: [story_id], references: [id], onDelete: Cascade)
}

model Story_Genre {
  story_id String @db.Uuid
  genre    Genre

  story Story @relation(fields: [story_id], references: [id], onDelete: Cascade)

  @@id([story_id, genre])
}

model Rating {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  story_id   String   @db.Uuid
  star       Int      @default(0) // 0-5
  message    String?
  create_at  DateTime @default(now())
  is_deleted Boolean  @default(false)

  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  story Story @relation(fields: [story_id], references: [id], onDelete: Cascade)
}

model Comment {
  id            String   @id @default(uuid()) @db.Uuid
  parent_id     String?  @db.Uuid // reply to another comment
  story_id      String   @db.Uuid
  story_node_id String?  @db.Uuid
  user_id       String   @db.Uuid
  message       String
  created_at    DateTime @default(now())
  is_deleted    Boolean  @default(false)

  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  story      Story      @relation(fields: [story_id], references: [id], onDelete: Cascade)
  story_node StoryNode? @relation(fields: [story_node_id], references: [id], onDelete: Cascade)
  parent     Comment?   @relation("CommentToComment", fields: [parent_id], references: [id], onDelete: Cascade)
  children   Comment[]  @relation("CommentToComment")
}

model RefreshToken {
  user_id String @db.Uuid
  token   String @unique

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, token])
}
