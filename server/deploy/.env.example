# ==============================================================================
# SERVER ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
NODE_ENV=production
APP_PORT=5000
API_KEY=your_api_key_here
ADMIN_TOKEN=your_admin_jwt_token_here

CLIENT_URL=https://mangament.netlify.app
BACKEND_URL=https://mangament.io.vn
CORS_WHITE_LIST=http://localhost:3000,https://mangament.netlify.app,https://mangament.io.vn
LOG_LEVEL=info

# ==============================================================================
# STORAGE DIRECTORIES (HOST / COMPOSE VOLUME INTERPOLATION)
# ==============================================================================
# Đường dẫn thư mục public trên host máy chủ (ví dụ: ổ cứng gắn ngoài /mnt/hdd1/public)
PUBLIC_DIR=/mnt/hdd1/public
# Đường dẫn thư mục tạm để nhận và giải nén file zip upload
TEMP_DIR=/mnt/hdd1/temp
CLEANUP_ZIP_AFTER_PROCESSING=true
MIN_DISK_FREE_SPACE_MB=1024

# ==============================================================================
# DATABASES & CACHING
# ==============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mangament_postgres_db?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/mangament_postgres_db
MONGODB_CONNECTION_STRING=mongodb://admin:password@localhost:27016/management_logs?authSource=admin
REDIS_URL=redis://localhost:6379

# ==============================================================================
# AUTHENTICATION (JWT & GOOGLE OAUTH)
# ==============================================================================
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_ACCESS_EXPIRES_IN=365d
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d
COOKIES_REFRESH_TOKEN_KEY=refreshToken

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==============================================================================
# CLOUDFLARE R2 & STORAGE PROVIDER
# ==============================================================================
STORAGE_PROVIDER=local
CLOUDFLARE_R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
CLOUDFLARE_R2_TOKEN=your_cloudflare_r2_token
CLOUDFLARE_R2_BUCKET=mangament
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
CDN_URL=https://pub-your_id.r2.dev

DEFAULT_AVATAR_IAMGE_URL=https://pub-your_id.r2.dev/user/avatar/avatar.png
DEFAULT_AVATAR_IAMGE_KEY=user/avatar/avatar.png

# ==============================================================================
# EMAIL SERVICE (GMAIL SMTP)
# ==============================================================================
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_digit_app_password

# ==============================================================================
# SERVICES & TUNNEL
# ==============================================================================
ML_SERVICE_URL=http://localhost:8000
TUNNEL_TOKEN=your_cloudflare_tunnel_token
