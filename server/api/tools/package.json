{
  "name": "mangament-tools",
  "version": "1.0.0",
  "description": "Desktop Application Suite & CLI Tools cho hệ thống Mangament",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "build": "vite build",
    "start": "vite build && electron .",
    "dev": "concurrently \"vite\" \"cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "app": "npm run start",
    "cli:zip": "node pack-stories-zip/index.js",
    "cli:pdf": "node pack-stories-pdf/index.js",
    "dry-run": "node pack-stories-zip/index.js --dry-run",
    "fast": "node pack-stories-zip/index.js --fast",
    "store": "node pack-stories-zip/index.js --store"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.7",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "tailwindcss": "^4.0.7",
    "vite": "^6.1.0"
  }
}
