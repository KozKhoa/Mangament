generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                  String @id @default(uuid()) @db.Uuid
  user_id             String @db.Uuid
  provider            String @default("email")
  provider_account_id String

  password String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_account_id])
}

model User {
  id             String        @id @default(uuid()) @db.Uuid
  name           String
  email          String        @unique
  gender         Gender?       @default(other)
  birthday       DateTime?
  join_date      DateTime      @default(now())
  role           Role          @default(user)
  nation_id      String?       @db.Uuid
  avatar_id      String?       @db.Uuid
  deleted_status DeletedStatus @default(not_deleted)
  is_banned      Boolean       @default(false)

  comments          Comment[]
  favourite_story   FavouriteStory[]
  story_rating      Rating[]
  reading_history   ReadingHistory[]
  refresh_token     RefreshToken[]
  posted_story      Story[]
  poster_story_node StoryNode[]
  avatar            Image?           @relation(fields: [avatar_id], references: [id])
  nation            Nation?          @relation(fields: [nation_id], references: [id])
  accounts          Account[]
}

model Story {
  id                 String                 @id @default(uuid()) @db.Uuid
  title              String                 @unique
  other_titles       String[]
  view               Int                    @default(0)
  star               Float                  @default(0)
  rating_count       Int                    @default(0)
  type               StoryType
  status             StoryStatus            @default(ongoing)
  next_chapter_in    DateTime?
  number_of_children Int                    @default(0)
  cover_art_id       String?                @db.Uuid
  nation_id          String?                @db.Uuid
  deleted_status     DeletedStatus          @default(not_deleted)
  is_actived         Boolean                @default(true)
  poster_id          String?                @db.Uuid
  created_at         DateTime               @default(now())
  updated_at         DateTime               @default(now())
  summary            String?
  embedding          Unsupported("vector")?
  comment            Comment[]
  favourite          FavouriteStory[]
  rating             Rating[]
  reading_history    ReadingHistory[]
  cover_art          Image?                 @relation(fields: [cover_art_id], references: [id])
  nation             Nation?                @relation(fields: [nation_id], references: [id])
  poster             User?                  @relation(fields: [poster_id], references: [id])
  children           StoryNode[]
  authors            Story_Author[]
  genres             Story_Genre[]
}

model StoryNode {
  id                 String             @id @default(uuid()) @db.Uuid
  story_id           String?            @db.Uuid
  parent_id          String?            @db.Uuid
  title              String?
  type               StoryNodeType
  order_index        Float?             @db.Real
  view               Int                @default(0)
  number_of_children Int                @default(0)
  updated_at         DateTime           @default(now())
  created_at         DateTime           @default(now())
  deleted_status     DeletedStatus      @default(not_deleted)
  poster_id          String?            @db.Uuid
  comment            Comment[]
  reading_history    ReadingHistory[]
  parent             StoryNode?         @relation("StoryNodeToStoryNode", fields: [parent_id], references: [id], onDelete: Cascade)
  children           StoryNode[]        @relation("StoryNodeToStoryNode")
  poster             User?              @relation(fields: [poster_id], references: [id])
  story              Story?             @relation(fields: [story_id], references: [id], onDelete: Cascade)
  content            StoryNodeContent[]
}

model StoryNodeContent {
  id             String               @id @default(uuid()) @db.Uuid
  story_node_id  String               @db.Uuid
  type           StoryNodeContentType @default(text)
  order_index    Int
  content        String?
  image_id       String?              @db.Uuid
  deleted_status DeletedStatus        @default(not_deleted)
  created_at     DateTime             @default(now())
  image          Image?               @relation(fields: [image_id], references: [id], onDelete: Cascade)
  story_node     StoryNode            @relation(fields: [story_node_id], references: [id], onDelete: Cascade)
}

model Image {
  id                 String             @id @default(uuid()) @db.Uuid
  url                String?            @unique
  key                String?            @unique
  public_id          String?            @unique
  width              Int?
  height             Int?
  deleted_status     DeletedStatus      @default(not_deleted)
  created_at         DateTime           @default(now())
  author             Author[]
  nation             Nation[]
  story              Story[]
  story_node_content StoryNodeContent[]
  user               User[]
  genres             Genre[]
}

model Author {
  id        String         @id @default(uuid()) @db.Uuid
  name      String
  nation_id String?        @db.Uuid
  avatar_id String?        @db.Uuid
  avatar    Image?         @relation(fields: [avatar_id], references: [id])
  nation    Nation?        @relation(fields: [nation_id], references: [id])
  story     Story_Author[]
}

model Story_Author {
  story_id  String @db.Uuid
  author_id String @db.Uuid
  author    Author @relation(fields: [author_id], references: [id], onDelete: Cascade)
  story     Story  @relation(fields: [story_id], references: [id], onDelete: Cascade)

  @@id([story_id, author_id])
}

model ReadingHistory {
  id             String        @id @default(uuid()) @db.Uuid
  user_id        String        @db.Uuid
  story_id       String        @db.Uuid
  story_node_id  String        @db.Uuid
  created_at     DateTime      @default(now())
  updated_at     DateTime      @default(now())
  deleted_status DeletedStatus @default(not_deleted)
  story          Story         @relation(fields: [story_id], references: [id], onDelete: Cascade)
  story_node     StoryNode     @relation(fields: [story_node_id], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model FavouriteStory {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  story_id   String   @db.Uuid
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  story      Story    @relation(fields: [story_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, story_id])
}

model Nation {
  id            String  @id @default(uuid()) @db.Uuid
  flag_image_id String? @db.Uuid
  flag_icon     String?
  name          String  @unique

  flag_image Image? @relation(fields: [flag_image_id], references: [id])

  author Author[]
  story  Story[]
  user   User[]
}

model Genre {
  id             String        @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  thumbnail_id   String?       @db.Uuid
  deleted_status DeletedStatus @default(not_deleted)

  thumbnail Image? @relation(fields: [thumbnail_id], references: [id])

  story_genres Story_Genre[]
}

model Story_Genre {
  story_id String @db.Uuid
  genre_id String @db.Uuid

  created_at     DateTime      @default(now())
  deleted_status DeletedStatus @default(not_deleted)

  story Story @relation(fields: [story_id], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genre_id], references: [id], onDelete: Cascade)

  @@id([story_id, genre_id])
}

model Rating {
  id             String        @id @default(uuid()) @db.Uuid
  user_id        String        @db.Uuid
  story_id       String        @db.Uuid
  star           Int           @default(0)
  title          String
  content        String
  created_at     DateTime      @default(now())
  updated_at     DateTime      @default(now())
  deleted_status DeletedStatus @default(not_deleted)
  story          Story         @relation(fields: [story_id], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, story_id])
}

model Comment {
  id             String        @id @default(uuid()) @db.Uuid
  parent_id      String?       @db.Uuid
  story_id       String        @db.Uuid
  story_node_id  String?       @db.Uuid
  user_id        String        @db.Uuid
  title          String
  content        String
  created_at     DateTime      @default(now())
  updated_at     DateTime      @default(now())
  deleted_status DeletedStatus @default(not_deleted)
  parent         Comment?      @relation("CommentToComment", fields: [parent_id], references: [id], onDelete: Cascade)
  children       Comment[]     @relation("CommentToComment")
  story          Story         @relation(fields: [story_id], references: [id], onDelete: Cascade)
  story_node     StoryNode?    @relation(fields: [story_node_id], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model RefreshToken {
  user_id String @db.Uuid
  token   String @unique
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, token])
}

enum StoryNodeContentType {
  image
  text
  header
  title
}

enum Role {
  user
  admin
}

enum StoryStatus {
  ongoing
  finished
  postpone
  upcoming
}

enum StoryType {
  manga
  light_novel
}

enum StoryNodeType {
  chapter
  arc
  volume
}

enum Gender {
  male
  female
  other
}

enum DeletedStatus {
  not_deleted
  soft_deleted
  soft_deleted_by_parent // This mean this is delete by its parent being soft deleted, and it will be un-deleted when the parent is un-deleted
  pending_permanent_deletion
}
