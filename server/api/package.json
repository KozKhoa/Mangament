{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "App.js",
  "prisma": {
    "seed": "node prisma/seeds/index.js"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon App.js",
    "worker": "cross-env NODE_ENV=development node WorkerApp.js",
    "lint": "npx eslint .",
    "format": "npx prettier --write .",
    "upload": "cross-env NODE_ENV=development node Upload.js",
    "start": "cross-env NODE_ENV=production node App.js",
    "build": "npm i && npx prisma generate",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "migrate": "npx prisma migrate dev && npx prisma generate dev",
    "seed": "npx prisma db seed",
    "prepare": "husky install"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@faker-js/faker": "^10.3.0",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.73.3",
    "chokidar": "^4.0.3",
    "cloudinary": "^1.41.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.4",
    "express": "^5.1.0",
    "fs": "^0.0.1-security",
    "google-auth-library": "^10.6.2",
    "googleapis": "^170.0.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.2.0",
    "mongoose": "^9.6.3",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^7.0.12",
    "nodemon": "^3.1.10",
    "openai": "^6.32.0",
    "p-limit": "^7.3.0",
    "path": "^0.12.7",
    "pg": "^8.16.3",
    "redis": "^5.10.0",
    "sharp": "^0.32.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "winston": "^3.18.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prisma": "^7.6.0",
    "tsx": "^4.21.0",
    "vitest": "^4.1.4"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  }
}
