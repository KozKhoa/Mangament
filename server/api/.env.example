# ==============================================================================
# APPLICATION & SERVER CONFIGURATION
# ==============================================================================
# Môi trường thực thi: development | production | test
NODE_ENV=development

# Cổng khởi chạy HTTP server
APP_PORT=5000

# Khóa bí mật API bảo vệ các internal / admin endpoints
API_KEY=your_api_key_here

# Token JWT quản trị viên dùng cho testing / script upload / seed
ADMIN_TOKEN=

# URL frontend client kết nối tới API
CLIENT_URL=https://mangament.netlify.app

# URL backend phục vụ nội dung tĩnh (ảnh upload local)
BACKEND_URL=http://localhost:5000

# Danh sách origin được phép truy cập (CORS), phân tách bằng dấu phẩy
CORS_WHITE_LIST=http://localhost:3000,https://mangament.netlify.app

# Mức độ ghi log của Winston Logger: 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL=info


# ==============================================================================
# DATABASE CONFIGURATION - POSTGRESQL (PRISMA ORM)
# ==============================================================================
# Chuỗi kết nối database chính (sử dụng connection pool trong production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mangament_postgres_db?schema=public

# Chuỗi kết nối trực tiếp đến PostgreSQL (bắt buộc dùng cho Prisma Migrations & Seeds)
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/mangament_postgres_db

# Thông tin xác thực PostgreSQL (dùng cho Docker container / local)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mangament_postgres_db
DB_PORT=5432


# ==============================================================================
# DATABASE CONFIGURATION - MONGODB (APPLICATION LOGS)
# ==============================================================================
# Chuỗi kết nối MongoDB lưu trữ log hoạt động hệ thống
MONGODB_CONNECTION_STRING=mongodb://admin:password@localhost:27017/management_logs?authSource=admin

# Cấu hình container MongoDB (Docker / Local)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USERNAME=admin
MONGO_PASSWORD=password


# ==============================================================================
# REDIS & BULLMQ (CACHING & ASYNC QUEUE WORKERS)
# ==============================================================================
# Kết nối Redis dùng cho cache dữ liệu và hàng đợi BullMQ (xử lý upload ảnh, email)
REDIS_URL=redis://localhost:6379


# ==============================================================================
# AUTHENTICATION & SECURITY (JWT & COOKIES)
# ==============================================================================
# Khóa bí mật ký Access Token
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_ACCESS_EXPIRES_IN=365d

# Khóa bí mật ký Refresh Token
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=30d

# Tên cookie lưu Refresh Token trên trình duyệt
COOKIES_REFRESH_TOKEN_KEY=refreshToken


# ==============================================================================
# GOOGLE OAUTH 2.0 (SSO LOGIN)
# ==============================================================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret


# ==============================================================================
# STORAGE PROVIDER (LOCAL DISK & CLOUDFLARE R2)
# ==============================================================================
# Chọn nơi lưu trữ file: "local" (lưu vào thư mục public) hoặc "r2" (Cloudflare R2)
STORAGE_PROVIDER=local

# Cấu hình Cloudflare R2 / S3-compatible (sử dụng khi STORAGE_PROVIDER=r2)
CLOUDFLARE_R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
CLOUDFLARE_R2_TOKEN=your_cloudflare_r2_token
CLOUDFLARE_R2_BUCKET=your_bucket_name
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key

# Public CDN domain phân phối ảnh từ R2
CDN_URL=https://pub-your_id.r2.dev

# Avatar mặc định khi tạo tài khoản
DEFAULT_AVATAR_IAMGE_URL=https://pub-your_id.r2.dev/user/avatar/avatar.png
DEFAULT_AVATAR_IAMGE_KEY=user/avatar/avatar.png


# ==============================================================================
# EMAIL SERVICE (NODEMAILER / GMAIL SMTP)
# ==============================================================================
# Email tài khoản gửi thư (ví dụ gửi mã xác thực OTP)
EMAIL_USER=your_email@gmail.com

# Mật khẩu ứng dụng 16 chữ số từ Google Account (App Password)
EMAIL_APP_PASSWORD=your_16_digit_app_password


# ==============================================================================
# EXTERNAL SERVICES & CLOUDFLARED TUNNEL
# ==============================================================================
# URL microservice Machine Learning (Gợi ý truyện / xử lý thông minh)
ML_SERVICE_URL=http://localhost:8000

# Token định danh Cloudflare Tunnel (cloudflared service)
TUNNEL_TOKEN=
